{
  "Monitoreo": {
    "Exclusiones": [
      "/.cache/",
      "/.config/",
      "/.local/share/",
      "/Logs/",
      "/tmp/",
      "/.local/state/",
      "wireplumber",
      ".log",
      ".tmp",
      ".git",
      "swp",
      ".lock",
      "CiberGuard_Audit",
      ".sqlite",
      ".sqlite-wal",
      ".sqlite-shm",
      ".new"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "EscudoRed": {
      "VentanaTiempoSegundos": 60,
      "MaxIntentosPermitidos": 3,
      "MinutosEnfriamientoAlerta": 5
    }
  
}